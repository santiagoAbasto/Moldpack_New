{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "moldpack/cms",
  "type": "project",
  "license": "proprietary",
  "description": "CMS editorial de Moldpack sobre Laravel 13",
  "require": {
    "php": "^8.5",
    "barryvdh/laravel-dompdf": "^3.1",
    "inertiajs/inertia-laravel": "^3.3",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "phpunit/phpunit": "^13.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""],
    "post-create-project-cmd": ["@php artisan key:generate --ansi", "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"", "@php artisan migrate --graceful --ansi"]
  },
  "extra": {"laravel": {"dont-discover": []}},
  "config": {"optimize-autoloader": false, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
